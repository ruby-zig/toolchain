#!/usr/bin/env bash
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=rz-common
source "$here/rz-common"
rz_require_zig
rz_classify_ranlib_operation "$@"
rz_receipt host-ranlib "${RZ_ZIG_HOST_TARGET:-native}" "$RZ_OPERATION" "$@"
exec "$RZ_ZIG" ranlib "$@"
