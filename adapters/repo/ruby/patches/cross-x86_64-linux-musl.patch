diff --git a/thread_pthread.c b/thread_pthread.c
--- a/thread_pthread.c
+++ b/thread_pthread.c
@@ -2445,6 +2445,14 @@ native_thread_init_main_thread_stack(void *addr)
         void* stackaddr;
         size_t size;
         if (get_main_stack(&stackaddr, &size) == 0) {
+#if defined(HAVE_GETRLIMIT)
+            struct rlimit rlim;
+            /* musl reports only the currently mapped part of the main stack. */
+            if (getrlimit(RLIMIT_STACK, &rlim) == 0 &&
+                rlim.rlim_cur != RLIM_INFINITY && rlim.rlim_cur > size) {
+                size = (size_t)rlim.rlim_cur;
+            }
+#endif
             native_main_thread.stack_maxsize = size;
             native_main_thread.stack_start = stackaddr;
             goto bound_check;
